{% set tableRows = [] %}
{% for order in orders %}
  {% set name %}
  <a class="govuk-link" aria-describedby="order-{{ order.index }}-status" href="{{ order.href }}">
    {{ order.name }}
  </a>
  {% endset %}
  {% set status %}
  <div id="order-{{ order.index }}-status">
    {% for tag in order.statusTags %}
      {% if tag.type == 'VARIATION' %}
        {% set colour = "blue" %}
      {% elif tag.type == 'SUBMITTED' %}
        {% set colour = "green" %}
      {% elif tag.type == 'FAILED' %}
        {% set colour = "red" %}
      {% elif tag.type == 'DRAFT' %}
        {% set colour = "grey" %}
      {% elif tag.type == 'REJECTED' %}
        {% set colour = "red" %}
      {% endif %}
      <strong class="govuk-tag govuk-tag--{{ colour }} govuk-!-margin-right-2">{{ tag.text }}</strong>
    {% endfor %}
  </div>
  {% endset %}
{% if isPrisonOrYouthUser %}
    {% set row = [
    {
      html: name
    },
    {
      text: order.startDate
    },
    {
      text: order.lastUpdatedDateTime
    },
    {
      text: order.lastUpdatedBy
    },
    {
      html: status
    }
  ] %}
{% else %}
 {% set row = [
    {
      html: name
    },
    {
      text: order.startDate
    },
    {
      html: status
    }
  ] %}
  {% endif %}
  {% set tableRows = (tableRows.push(row), tableRows) %}
{% endfor %}
<div id="ordersList">
{% if isPrisonOrYouthUser %}
  {% set tableHead = [
    { text: "Name", classes: "govuk-!-width-one-half" },
    { text: "Start date" },
    { text: "Last updated" },
    { text: "Updated by" },
    { text: "Status" }
  ] %}
{% else %}
  {% set tableHead = [
    { text: "Name", classes: "govuk-!-width-two-thirds" },
    { text: "Start date" },
    { text: "Status" }
  ] %}
{% endif %}

  {% if orders.length > 0 %}
    {{ govukTable ({
        firstCellIsHeader: false,
        head: tableHead,
        rows: tableRows
      }) }}
  {% endif %}
  {% if orders.length == 0 %}
    <p class="govuk-body">You have no draft forms</p>
  {% endif %}
  {% if pagination %}
    {{ mojPagination(pagination) }}
  {% endif %}
</div>
