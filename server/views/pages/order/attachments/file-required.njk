{% extends "../../../partials/form-layout.njk" %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% set section = 'Additional documents' %}

{% set guidanceHtml %}
  {% if question.guidance %}
    <p class="govuk-body">{{ question.guidance.intro }}</p>
    <ul class="govuk-list govuk-list--bullet">
      {% for item in question.guidance.items %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
    <p class="govuk-body">{{ question.guidance.outro }}</p>
  {% endif %}
{% endset %}

{% set questionName = title%}
{% block formInputs %}

  {{ govukRadios({
  classes: "govuk-radios--inline",
  name: "fileRequired",
  errorMessage: fileRequired.error,
  value: fileRequired.value,
  fieldset: {
    legend: {
      text: question.text,
      isPageHeading: true,
      classes: "govuk-fieldset__legend--l"
    }
  },
  hint: {
    text: question.hint,
    html: guidanceHtml if question.guidance
  },
  items: [
    {
      value: "yes",
      text: "Yes",
      disabled: not isOrderEditable
    },
    {
      value: "no",
      text: "No",
      disabled: not isOrderEditable
    }
  ]
}) }}

{% endblock %}
